# Morpheus environment variables
# Copy this file to `.env.local` and fill in your secrets.
# .env.local is gitignored — never commit it.

# ─── Anthropic API key ─────────────────────────────────────────────
# Required to enable the in-canvas Strategy Assistant chat panel.
# Get one from https://console.anthropic.com/ → Settings → API Keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# ─── Optional: override the model used by the chat panel ───────────
# Default is claude-haiku-4-5-20251001 (cheap + fast). For higher
# quality answers (slower, ~10x cost) try claude-sonnet-4-5-20250929
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ─── Optional: LI.FI API key (bridge route quotes) ──────────────────
# NOT required. LI.FI's API is keyless — the Bridge node already quotes
# Stargate/Across/Relay/CCTP routes without any key. A free self-serve key
# from https://portal.li.fi/ only raises the rate limit (keyless is ~75
# route requests / 2h; quotes are debounced + cached 30s server-side).
LIFI_API_KEY=

# ─── Optional: LayerZero Value Transfer API key ─────────────────────
# NOT required — Stargate routes already come through LI.FI. This adds
# Stargate's own native quotes. The key is partner-gated (no public signup;
# the docs say "contact the LayerZero team"), so most setups leave it empty.
# Docs: https://docs.layerzero.network/v2/developers/value-transfer-api
# Sent server-side only, as the `x-api-key` header.
LAYERZERO_API_KEY=
